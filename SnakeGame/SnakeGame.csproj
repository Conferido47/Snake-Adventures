<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SnakeGame</RootNamespace>
    <AssemblyName>SnakeAdventures</AssemblyName>
    <Product>Snake Adventures</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>SnakeAdventures.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SnakeAdventures.ico" LogicalName="SnakeGame.SnakeAdventures.ico" />
  </ItemGroup>
</Project>
